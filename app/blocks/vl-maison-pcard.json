:#f4f4f0\"></button>\n<button type=\"button\" class=\"vl-pc-dot\" data-color=\"Черный\" aria-label=\"Черный\" style=\"background:#1a1a1a\"></button>\n<button type=\"button\" class=\"vl-pc-dot\" data-color=\"Терракотовый\" aria-label=\"Терракотовый\" style=\"background:#ad8475\"></button>\n</div>\n</div>\n<div class=\"vl-pc-sizeswrap\">\n<div class=\"vl-pc-sizehead\"><span class=\"vl-pc-sublabel\" style=\"margin-bottom:0\">Размер</span><button type=\"button\" class=\"vl-pc-sizechart\">Таблица размеров</button></div>\n<div class=\"vl-pc-sizes\">\n<button type=\"button\" class=\"vl-pc-size\">XS</button>\n<button type=\"button\" class=\"vl-pc-size selected\">S</button>\n<button type=\"button\" class=\"vl-pc-size\">M</button>\n<button type=\"button\" class=\"vl-pc-size\" disabled>L</button>\n</div>\n</div>\n<a class=\"vl-pc-btn landing-block-node-pc-btn\" href=\"#\" target=\"_self\">Добавить в корзину</a>\n<div class=\"vl-pc-info\">\n<div class=\"vl-pc-infoblock\">\n<h3 class=\"vl-pc-infoh\">Описание</h3>\n<p class=\"vl-pc-text landing-block-node-pc-desc\">Воплощение элегантности. Это платье миди выполнено из струящегося 100% шелка Mulberry, который деликатно подчеркивает силуэт.</p>\n</div>\n<div class=\"vl-pc-infoblock\">\n<h3 class=\"vl-pc-infoh\">Состав и уход</h3>\n<ul class=\"vl-pc-list\"><li>100% Шелк Mulberry</li><li>Только сухая чистка</li><li>Не отбеливать</li></ul>\n</div>\n</div>\n</div></div>\n</div>\n</div>\n</section>"
